# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env

# Chave usada para assinar os tokens JWT (obrigatória).
# Gere uma chave forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# O frontend (blog-app) precisa usar o MESMO valor em JWT_SECRET_KEY.
JWT_SECRET=troque-por-uma-chave-secreta-forte

# Porta HTTP da API (padrão: 3001)
PORT=3001

# Origens autorizadas pelo CORS, separadas por espaço (sem barra no final)
CORS_WHITELIST=http://localhost:3000 http://127.0.0.1:3000
